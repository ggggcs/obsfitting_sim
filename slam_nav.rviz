Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Toolbars:
  toolButtonStyle: 2
Tools:
  - Class: rviz/Interact
    Hide Inactive Objects: true
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
  - Class: rviz/SetInitialPose
    Theta std deviation: 0.2617993877991494
    Topic: /initialpose
    X std deviation: 0.5
    Y std deviation: 0.5
  - Class: rviz/SetGoal
    Topic: /move_base_simple/goal
  - Class: rviz/PublishPoint
    Single click: true
    Topic: /clicked_point
Visualization Manager:
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: <Fixed Frame>
    
    # LIO-SAM点云地图
    - Alpha: 0.3
      Autocompute Intensity Bounds: true
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Enabled: true
      Name: SLAM Map
      Topic: /lio_sam/mapping/map_global
      Size (m): 0.03
    
    # 当前激光扫描
    - Alpha: 1
      Class: rviz/PointCloud2
      Color: 0; 255; 127
      Enabled: true
      Name: Current Scan
      Topic: /velodyne_points
      Size (m): 0.02
    
    # 2D激光扫描
    - Alpha: 1
      Class: rviz/LaserScan
      Color: 255; 0; 0
      Enabled: true
      Name: 2D Scan
      Topic: /scan
    
    # 轨迹路径
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 25; 255; 0
      Enabled: true
      Name: Robot Path
      Topic: /lio_sam/mapping/path
    
    # 全局规划路径
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 255; 0
      Enabled: true
      Name: Global Plan
      Topic: /move_base/DWAPlannerROS/global_plan
      Line Style: Lines
      Line Width: 0.03
    
    # 局部规划路径
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 255; 255
      Enabled: true
      Name: Local Plan
      Topic: /move_base/DWAPlannerROS/local_plan
      Line Style: Lines
      Line Width: 0.03
    
    # NavFn全局路径
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 170; 0
      Enabled: true
      Name: NavFn Plan
      Topic: /move_base/NavfnROS/plan
      Line Style: Lines
      Line Width: 0.05
    
    # 局部代价地图
    - Alpha: 0.7
      Class: rviz/Map
      Color Scheme: costmap
      Enabled: true
      Name: Local Costmap
      Topic: /move_base/local_costmap/costmap
    
    # TF坐标系
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Axes: true
      Show Names: false
      Frame Timeout: 15
      Marker Scale: 1
    
    # 机器人模型
    - Alpha: 1
      Class: rviz/RobotModel
      Enabled: true
      Name: Robot Model
      Robot Description: robot_description
    
    # 当前导航目标
    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.1
      Class: rviz/Pose
      Color: 255; 25; 0
      Enabled: true
      Name: Current Goal
      Topic: /move_base/current_goal
      Shape: Arrow
  
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  
  Name: root
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 20
      Enable Stereo Rendering:
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.785
      Target Frame: <Fixed Frame>
      Yaw: 0.785
