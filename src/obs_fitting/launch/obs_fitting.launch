<launch>
<arg name="cloud_topic" default="/velodyne_points"/>

  <node name="obs_fitting" pkg="obs_fitting" type="main" output="screen">
    <rosparam command="load" file="$(find obs_fitting)/config/params.yaml" />
    <param name="cloud_topic" value="$(arg cloud_topic)"/>
  </node>

  <node name="$(anon rviz)" pkg="rviz" type="rviz" args="-d $(find obs_fitting)/rviz/obs_fitting.rviz"/>

</launch>


