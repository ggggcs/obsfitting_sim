<?xml version="1.0" ?>
<robot name="ackermann11" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:property name="PI" value="3.1415926" />
	<!--基座-->
	<xacro:property name="base_height" value="0.4" />
	<xacro:property name="base_width" value="0.6" />
	<xacro:property name="base_length" value="1.0" />
	<xacro:property name="base2ground" value="0.15" />
	<!--车轮-->
	<xacro:property name="wheel_radius" value="0.15" />
	<xacro:property name="wheel_length" value="0.1" />
	<xacro:property name="wheel_max_angle" value="${30/180*PI}" />
	
	<!--连接杆-->
	<xacro:property name="steer_link_length" value="0.05" /> 
	<xacro:property name="steer_link_width" value="0.1" />
	<xacro:property name="steer_link_height" value="0.05" />
	<!--质量-->
	<xacro:property name="base_m" value="60" />
	<xacro:property name="wheel_m" value="15" />  
	<xacro:property name="steer_link_m" value="3" /> 
    
	<xacro:include filename="inertial_matrix.xacro"/>
    
	<link name="base_footprint">
		<visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="0.001"/>
            </geometry>
            <material name="yellow">
                <color rgba="0.8 0.3 0.1 0.5" />
            </material> 
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="0"/>
            </geometry>
        </collision>
    </link>

    <link name="base_link">
        <xacro:Box_inertial_matrix m="${base_m}" l="${base_length}" w="${base_width}" h="${base_height}" />
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1.0 0.5" />
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
    </link>
    <gazebo reference="base_link">
            <material>Gazebo/Blue</material>
    </gazebo>
    <joint name="base_link2base_footprint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 ${base2ground+base_height/2+0.001}" rpy="0.0 0.0 0.0"/>
    </joint>
	
	<xacro:macro name="define_front" params="name flag">
		<link name="${name}_front_steer_link">
			<visual>
				<geometry>
					<box size="${steer_link_length} ${steer_link_width} ${steer_link_height}"/>
				</geometry>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="white1">
					<color rgba="1.0 1.0 1.0 0"/>
				</material>
			</visual>
			<collision>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<geometry>
					<box size="${steer_link_length} ${steer_link_width} ${steer_link_height}"/>
				</geometry>
			</collision>
			<xacro:Box_inertial_matrix m="${steer_link_m}" l="${steer_link_length}" w="${steer_link_width}" h="${steer_link_height}"/>
		</link>
		<gazebo reference="${name}_front_steer_link">
			<material>Gazebo/White</material>
		</gazebo>
		
		<joint name="${name}_front_steerlink2base_joint" type="revolute">
			<parent link="base_link"/>
			<child link="${name}_front_steer_link"/>
			<origin xyz="${base_length/2-wheel_radius} ${flag*(base_width/2+wheel_length/2-steer_link_width/2)} ${-(base2ground+base_height/2-wheel_radius)}" rpy="0.0 0.0 0.0"/>
			<axis xyz="0 0 1"/>
			<dynamics damping="0.5" />
            <limit lower="${-wheel_max_angle}" upper="${wheel_max_angle}" effort="0" velocity="3"/>
		</joint>
		
		<link name="${name}_front_wheel_link">
			<visual>
				<geometry>
					<cylinder length="${wheel_length}" radius="${wheel_radius}"/>
				</geometry>
				<origin xyz="0.0 0.0 0.0" rpy="${-PI/2} 0.0 0.0"/>
				<material name="white">
					<color rgba="1.0 1.0 1.0 0.5"/>
				</material>
			</visual>
			<collision>
				<geometry>
					<cylinder length="${wheel_length}" radius="${wheel_radius}"/>
				</geometry>
				<origin xyz="0.0 0.0 0.0" rpy="${-PI/2} 0.0 0.0"/>
			</collision>
			<xacro:cylinder_inertial_matrix m="${wheel_m}" r="${wheel_radius}" h="${wheel_length}"/>
		</link>
		<gazebo reference="${name}_front_wheel_link">
			<material>Gazebo/White</material>
			<mu1>0.9</mu1>
			<mu2>0.6</mu2>
		</gazebo>
		
		<joint name="${name}_frontwheel2steerlink_joint" type="continuous">
			<parent link="${name}_front_steer_link"/>
			<child link="${name}_front_wheel_link"/>
			<origin xyz="0.0 ${-flag*(steer_link_width/2 - wheel_length/2)} 0.0" rpy="0.0 0.0 0.0"/>
			<axis xyz="0 1 0"/>
		</joint>
		
		<transmission name="${name}_steer_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${name}_front_steerlink2base_joint">
                <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
            <actuator name="${name}_steer_actuator">
                <mechanicalReduction>1.0</mechanicalReduction>
                <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </actuator>
        </transmission>
	</xacro:macro>
	
	<xacro:define_front name="left" flag="1"/>
	<xacro:define_front name="right" flag="-1"/>
	
	
	<xacro:macro name="define_rear" params="name flag" >
		<link name="${name}_rear_steer_link">
			<visual>
				<geometry>
					<box size="${steer_link_length} ${steer_link_width} ${steer_link_height}"/>
				</geometry>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="red1">
					<color rgba="1.0 0.0 0.0 0"/>
				</material>
			</visual>
			<collision>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<geometry>
					<box size="${steer_link_length} ${steer_link_width} ${steer_link_height}"/>
				</geometry>
			</collision>
			<xacro:Box_inertial_matrix m="${steer_link_m}" l="${steer_link_length}" w="${steer_link_width}" h="${steer_link_height}"/>
		</link>
		<gazebo reference="${name}_rear_steer_link">
			<material>Gazebo/Red</material>
		</gazebo>
		
		<joint name="${name}_rear_steerlink2base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="${name}_rear_steer_link"/>
			<origin xyz="${-(base_length/2-wheel_radius)} ${flag*(base_width/2+wheel_length/2-steer_link_width/2)} ${-(base2ground+base_height/2-wheel_radius)}" rpy="0.0 0.0 0.0"/>
		</joint>
		
		<link name="${name}_rear_wheel_link">
			<visual>
				<geometry>
					<cylinder length="${wheel_length}" radius="${wheel_radius}"/>
				</geometry>
				<origin xyz="0.0 0.0 0.0" rpy="${-PI/2} 0.0 0.0"/>
				<material name="red">
					<color rgba="1.0 0.0 0.0 0.5"/>
				</material>
			</visual>
			<collision>
				<geometry>
					<cylinder length="${wheel_length}" radius="${wheel_radius}"/>
				</geometry>
				<origin xyz="0.0 0.0 0.0" rpy="${-PI/2} 0.0 0.0"/>
			</collision>
			<xacro:cylinder_inertial_matrix m="${wheel_m}" r="${wheel_radius}" h="${wheel_length}"/>
		</link>
		<gazebo reference="${name}_rear_wheel_link">
			<material>Gazebo/Red</material>
			<mu1>1.8</mu1>
			<mu2>1.2</mu2>
		</gazebo>
		
		<joint name="${name}_rearwheel2steerlink_joint" type="continuous">
			<parent link="${name}_rear_steer_link"/>
			<child link="${name}_rear_wheel_link"/>
			<origin xyz="0.0 ${-flag*(steer_link_width/2 - wheel_length/2)} 0.0" rpy="0.0 0.0 0.0"/>
			<axis xyz="0 1 0"/>
		</joint>
		
		<transmission name="${name}_rear_wheel_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${name}_rearwheel2steerlink_joint">
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            </joint>
            <actuator name="${name}_rear_wheel_actuator">
                <mechanicalReduction>1.0</mechanicalReduction>
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            </actuator>
        </transmission>
	</xacro:macro>
	
	<xacro:define_rear name="left" flag="1"/>
	<xacro:define_rear name="right" flag="-1"/>
	
	
	<gazebo>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
            <robotParam>robot_description</robotParam>
            <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
            <legacyModeNS>true</legacyModeNS>
            <robotBaseFrame>base_footprint</robotBaseFrame> 
            <publishJointStates>false</publishJointStates>
        </plugin>
        <publishJointState>false</publishJointState>
    </gazebo>
    <gazebo reference="base_footprint">
        <turnGravityOff>true</turnGravityOff>
    </gazebo>
    
    
	<gazebo reference="base_link">
		<gravity>true</gravity>
		<sensor name="imu_sensor" type="imu">
		<always_on>true</always_on>
		<update_rate>100</update_rate>
		<visualize>true</visualize>
		<topic>__default_topic__</topic>
		<plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
		    <topicName>imu</topicName>
		    <appendRobotNamespace>true</appendRobotNamespace>
		    <bodyName>base_link</bodyName>
		    <updateRateHZ>100.0</updateRateHZ>
		    <gaussianNoise>0.0</gaussianNoise>
		    <xyzOffset>0 0 0</xyzOffset>
		    <rpyOffset>0 0 0</rpyOffset>
		    <frameName>imu_link</frameName>
		</plugin>
		<pose>0 0 0 0 0 0</pose>
		</sensor>
	</gazebo>

</robot>
