<?xml version="1.0" ?>
<robot name="ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">
	
    <arg name="use_velodyne" default="false"/>
    <arg name="use_realsense" default="false"/>
    <arg name="robot_namespace" default="aaa3ck"/>
	
    <xacro:include filename="ack.xacro"/>
    <xacro:include filename="mylaser.xacro"/>
    
    
</robot>
