<launch>

    <!-- 启动 gazebo -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch" />

    <include file="$(find urdf_rviz)/launch/ack_without_gazebo.launch">
        <arg name="robot_namespace" value="ack11"/>
        <arg name="x" value="0.0"/> 
        <arg name="y" value="5.0"/>
        <arg name="z" value="0.0"/>
        <arg name="yaw" value="0.0"/>
        <arg name="use_velodyne" value="true"/>
        <arg name="use_realsense" value="false"/>
    </include>

    <!-- <include file="$(find urdf_rviz)/launch/ack_without_gazebo.launch">
        <arg name="robot_namespace" value="/ack12"/>
        <arg name="x" value="-6.0"/>
        <arg name="y" value="0.0"/>
        <arg name="z" value="0.0"/>
        <arg name="yaw" value="0.0"/>
    </include>

    <include file="$(find urdf_rviz)/launch/ack_without_gazebo.launch">
        <arg name="robot_namespace" value="/ack13"/>
        <arg name="x" value="3.0"/>
        <arg name="y" value="-3.0"/>
        <arg name="z" value="0.0"/>
        <arg name="yaw" value="0.0"/>
    </include> -->

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find urdf_rviz)/rviz/rviz.rviz"/>

</launch>
